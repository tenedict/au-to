# 이 파일을 .env 로 복사한 뒤 OPENAI_API_KEY 만 실제 값으로 바꿉니다.
# .env 는 커밋하지 않습니다 (.gitignore).
#
#   cd backend && cp .env.example .env
#   # .env 를 열어 키를 넣고
#   set -a; source .env; set +a; npm start

# ── 여기만 채우면 됩니다 ───────────────────────────────
OPENAI_API_KEY=sk-proj-replace-me

# ── 아래는 그대로 두어도 동작합니다 ─────────────────────
# 구조화 추출 역할에 맞춘 기본 모델. 추론 계열(gpt-5*, o*)을 넣으면
# reasoning/verbosity 파라미터가 자동으로 함께 붙습니다.
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=8787
