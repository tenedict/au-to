// 이 파일의 사본이 Config/Secrets.xcconfig 로 있어야 빌드됩니다.
//
//   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//
// ./scripts/verify.sh 는 없으면 자동으로 만들어 줍니다.
// Secrets.xcconfig 는 .gitignore 에 있고 프로젝트 규칙 11 이 커밋을 막습니다.
// 값을 바꾸면 xcodegen generate 를 다시 돌립니다.
//
// **아래 기본값은 로컬 백엔드입니다.** 그대로 두면 http://127.0.0.1:8787 을 봅니다.

// ── 백엔드 주소 ──────────────────────────────────────────
// xcconfig 는 `//` 를 주석으로 봅니다. URL 의 `//` 가 잘리므로 쪼개 씁니다.
CAPTURETASK_SCHEME = http:/
CAPTURETASK_HOST = 127.0.0.1:8787
CAPTURETASK_API_BASE_URL = $(CAPTURETASK_SCHEME)/$(CAPTURETASK_HOST)

// 배포한 서버를 보려면 위 두 줄을 이렇게 바꿉니다.
//   CAPTURETASK_SCHEME = https:/
//   CAPTURETASK_HOST = capturetask-backend-xxxxxxxx.asia-northeast3.run.app

// ── 공유 비밀 ────────────────────────────────────────────
// 로컬 백엔드만 쓴다면 비워 둡니다. 배포한 서버는 이 값이 없으면 401 을 줍니다.
//
//   서버가 쓰는 값 보기:
//   gcloud secrets versions access latest --secret CAPTURETASK_CLIENT_KEY --project <PROJECT>
//
// 이 값은 **앱 번들에 들어갑니다.** OpenAI 키를 절대 여기에 넣지 마세요.
CAPTURETASK_CLIENT_KEY =
