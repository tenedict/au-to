# 이 파일을 .env 로 복사한 뒤 OPENAI_API_KEY 만 실제 값으로 바꿉니다.
# .env 는 커밋하지 않습니다 (.gitignore).
#
#   cd backend && cp .env.example .env
#   # .env 를 열어 키를 넣고
#   set -a; source .env; set +a; npm start

# ── 여기만 채우면 됩니다 ───────────────────────────────
OPENAI_API_KEY=sk-proj-replace-me

# ── 아래는 그대로 두어도 동작합니다 ─────────────────────
# 구조화 추출 역할에 맞춘 기본 모델. 추론 계열(gpt-5*, o*)을 넣으면
# reasoning/verbosity 파라미터가 자동으로 함께 붙습니다.
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=8787

# ── 외부에 노출할 때만 (배포) ───────────────────────────
# 앱과 서버가 나눠 갖는 공유 비밀. HOST 가 127.0.0.1 이 아니면 **필수**입니다.
#   만들기: openssl rand -base64 32
# 같은 값을 Config/Secrets.xcconfig 에도 넣어야 앱이 통과합니다.
# OpenAI 키를 여기에 넣으면 안 됩니다 — 이 값은 앱 번들에 들어갑니다.
WHENLY_CLIENT_KEY=

# 요청 한도. 비워 두면 IP 당 분당 10회 · 인스턴스 당 하루 500회입니다.
# 하루 한도가 **금액 상한**입니다.
WHENLY_RATE_PER_MINUTE=
WHENLY_RATE_PER_DAY=
